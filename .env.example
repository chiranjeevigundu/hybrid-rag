# Copy to .env and adjust. Every value here has a working default; nothing is required.

# Postgres. Matches docker-compose.yml (host port 5433 to avoid clashing with a
# default local Postgres on 5432).
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Embedding model. "hashing" swaps in the deterministic test stand-in, which needs no
# download and makes no semantic claim — useful for exercising the plumbing in CI.
RAG_MODEL=BAAI/bge-base-en-v1.5

# Must match the vector(N) column in migrations/001_schema.sql. Changing the model
# means changing both and re-indexing; existing vectors cannot be reinterpreted.
RAG_EMBEDDING_DIM=768

# Chunk sizing, in characters (~4 chars/token for English). The default leaves
# headroom under bge's 512-token window, which truncates silently when exceeded.
RAG_TARGET_CHARS=1200
RAG_OVERLAP_CHARS=150
RAG_MAX_CHARS=2000

RAG_BATCH_SIZE=64
# RAG_CACHE_DIR=.cache/models

# Retrieval. rrf_k damps the top of each ranked list during fusion (60 is the value
# from the paper that introduced RRF); candidates is how many each arm returns before
# fusion; rerank_candidates is how many of the fused list the cross-encoder rescores.
RAG_RRF_K=60
RAG_CANDIDATES=50
RAG_RERANK_CANDIDATES=25

# Cross-encoder reranker. "none" disables it; "identity" is the test stand-in.
# Measured as neutral-to-slightly-negative on the bundled corpus — see the README.
RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# The test suite drops and recreates its schema, so it never runs against the database
# above. Defaults to DATABASE_URL with "_test" appended, created on demand.
# TEST_DATABASE_URL=postgresql://rag:rag@localhost:5433/rag_test
